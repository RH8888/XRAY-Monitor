# 3x-ui connection settings
XRAY_3XUI_BASE_URL=https://panel.example.com
XRAY_3XUI_USERNAME=admin
XRAY_3XUI_PASSWORD=change-me
# Optional bearer/API token if your 3x-ui deployment exposes token auth.
XRAY_3XUI_TOKEN=

# Polling behavior
XRAY_POLL_INTERVAL_SECONDS=60
XRAY_LOG_COUNT=200

# Database URL. Use sqlite+aiosqlite for local/prod-lite; switch to postgresql+asyncpg later.
XRAY_DATABASE_URL=sqlite+aiosqlite:///./data/xray-monitor.db

# Telegram bot settings
XRAY_TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user IDs allowed to administer the bot.
XRAY_TELEGRAM_ADMIN_IDS=123456789,987654321

# Alert settings
XRAY_ALERTS_ENABLED=true
XRAY_ALERT_USAGE_THRESHOLD_PERCENT=80
XRAY_ALERT_COOLDOWN_SECONDS=3600
XRAY_ALERT_SEND_STARTUP_MESSAGE=false

# Logging
XRAY_LOG_LEVEL=INFO
